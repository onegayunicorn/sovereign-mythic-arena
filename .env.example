DATABASE_URL=postgresql://modelark:modelark@localhost:5432/modelark
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=modelark-local
PWA_DEMO_MODE=true
